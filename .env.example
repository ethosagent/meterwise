# Copy to .env (make setup does this). .env is gitignored. Dev-only values: never put a real
# provider key or a real Clerk key here. Read by make, docker compose and `meterwised` runs from make.

# --- Native run (make infra-up, make dev) ---
METERWISE_PG_PORT=54329
DATABASE_URL=postgres://meterwise:meterwise@127.0.0.1:54329/meterwise?sslmode=disable
TEST_DATABASE_URL=postgres://meterwise:meterwise@127.0.0.1:54329/meterwise?sslmode=disable

# --- Docker stack (make up) ---
# Host ports, all bound to 127.0.0.1.
APP_API_PORT=8081
APP_PROXY_PORT=8080
APP_ADMIN_PORT=9090
APP_PG_PORT=54330
MOCK_MINT_PORT=9444
APP_DB_PASSWORD=meterwise
# Signed in as admin after `make up`; created by bootstrap-admin (idempotent).
DEV_ADMIN_EMAIL=admin@meterwise.local
# The Clerk twin's fixed backend key and a dummy webhook secret (the twin sends no webhooks).
CLERK_SECRET_KEY=sk_test_clerkmock
CLERK_WEBHOOK_SECRET=whsec_ZGV2LW9ubHktd2ViaG9vay1zZWNyZXQ=

# --- Memory (trace library): Meterwise's own model key. Unset = memory off. Never a customer key. ---
# MEMORY_API_KEY=
# MEMORY_BASE_URL=https://api.openai.com/v1
# MEMORY_MODEL=gpt-4o-mini
# MEMORY_EMBED_MODEL=text-embedding-3-small
# MEMORY_SELF_BUDGET_USD=1
# MEMORY_TRACE_RETENTION_DAYS=90

# --- Release image only (make docker-build): your Clerk publishable key (public, ships in the bundle) ---
# CLERK_PUBLISHABLE_KEY=pk_test_...
