{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "MAX_MCP_OUTPUT_TOKENS": "15000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "15000"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/*:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(gofmt:*)",
      "Bash(go tool -modfile=tools/go.mod sqlc:*)",
      "Bash(go tool -modfile=tools/go.mod goose status:*)",
      "Bash(make:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npx biome:*)"
    ],
    "deny": [
      "Read(./go.sum)",
      "Read(./tools/go.sum)",
      "Read(./web/package-lock.json)",
      "Read(./.logs/**)",
      "Read(./**/*.out)",
      "Read(./bin/**)",
      "Read(./web/dist/**)",
      "Read(./web/node_modules/**)",
      "Read(./internal/store/sqlc/**)",
      "Read(./web/src/contract/generated.ts)",
      "Read(./internal/api/openapi.json)",
      "Read(./docs/schema.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/read-guard.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quiet-guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh" }]
      }
    ]
  }
}
